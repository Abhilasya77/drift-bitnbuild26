# Copy this file to .env and fill in values. NEVER commit .env to GitHub.

# ---- Local laptop (works with nothing else set) ----
AUTH_MODE=dev                      # dev = send header X-Demo-User: email ; supabase = real login tokens
STORAGE_MODE=local                 # local = backend/local_uploads ; supabase = private bucket
DATABASE_URL=sqlite:///./dev.db
REVIEWER_EMAILS=reviewer@drift.demo
CREDENTIAL_SECRET=replace-with-a-long-random-string
VERIFY_BASE_URL=http://localhost:5173/verify   # frontend verification page (QR points here)
CORS_ORIGINS=*

# ---- Supabase (Project Settings -> API, and Project Settings -> Database) ----
# AUTH_MODE=supabase
# STORAGE_MODE=supabase
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...      # secret! backend only
# STORAGE_BUCKET=identity-evidence

# ---- CompreFace (leave empty to use the labelled simulated biometric step) ----
# COMPREFACE_URL=http://localhost:8000
# COMPREFACE_API_KEY=your-verification-service-api-key
# BIOMETRIC_THRESHOLD=0.85

# ---- Web3 attestation (optional; see blockchain/README.md) ----
# WEB3_RPC_URL=https://rpc-amoy.polygon.technology
# WEB3_CONTRACT_ADDRESS=0x...
# WEB3_PRIVATE_KEY=0x...               # TESTNET-ONLY wallet. Secret!

CREDENTIAL_DAYS=90
REMINDER_DAYS=30,7
